generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String               @id @default(cuid())
  email       String               @unique
  password    String
  name        String
  role        Role                 @default(STAFF)
  createdAt   DateTime             @default(now())
  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Service {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String
  icon             String   @default("waves")
  image            String
  ctaLabel         String   @default("Get optimization")
  sortOrder        Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  shortDescription String?
  fullDescription  String?
  heroImage2       String?
  features         Json?
  overviewItems    Json?
  ctaUrl           String   @default("/contact")
  active           Boolean  @default(true)

  @@index([sortOrder])
  @@index([published])
  @@index([active])
}

model Portfolio {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  tags           Json?
  image          String
  heroImage      String?
  intro          String?
  description    Json?
  overviewText   String?
  overviewPoints Json?
  mediaImage     String?
  videoUrl       String?
  finalResult    Json?
  client         String?
  portfolio      String?
  service        String?
  date           String?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  award          String?
  challenge      String?
  highlightStats Json?
  solution       String?
  testimonial    String?

  @@index([sortOrder])
  @@index([published])
  @@index([active])
  @@index([category])
}

model Blog {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  excerpt      String
  content      String?
  image        String
  author       String
  authorAvatar String?
  date         String
  category     String
  tags         Json?
  comments     Int      @default(0)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
  @@index([published])
  @@index([active])
  @@index([category])
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  slug        String   @unique
  bio         String?
  image       String
  email       String?
  linkedin    String?
  twitter     String?
  instagram   String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  coreBeliefs Json?
  experience  Json?
  facebook    String?
  phone       String?
  skills      Json?

  @@index([sortOrder])
  @@index([published])
  @@index([active])
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String
  slug      String   @unique
  avatar    String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([published])
  @@index([active])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([published])
  @@index([active])
}

model Plan {
  id        String   @id @default(cuid())
  name      String   @unique
  monthly   String
  yearly    String
  features  String[]
  active    Boolean  @default(true)
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Float
  currency    String   @default("USD")
  interval    String
  features    Json?
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pricing_plans")
}

model ContentSection {
  id                   String            @id @default(cuid())
  sectionKey           ContentSectionKey @unique
  label                String
  eyebrow              String?
  title                String
  description          String?
  image                String?
  primaryButtonLabel   String?
  primaryButtonUrl     String?
  secondaryButtonLabel String?
  secondaryButtonUrl   String?
  items                Json?
  published            Boolean           @default(true)
  sortOrder            Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([sortOrder])
  @@index([published])
}

model ContactInfo {
  id             String   @id
  emailPrimary   String
  emailSecondary String?
  phone          String
  addressLine1   String
  addressLine2   String
  mapEmbedUrl    String?
  rating         Float?
  reviewCount    Int?
  updatedAt      DateTime
}

model ContactSubmission {
  id        String   @id
  firstName String
  lastName  String
  email     String
  phone     String?
  service   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  service   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum ContentSectionKey {
  HERO
  ABOUT
  PROCESS
  WORK
  TEAM
  CASE_STUDIES
  PRICING
  TESTIMONIALS
  CTA
  BLOG
  FAQ
  CAREERS
}

enum Role {
  ADMIN
  STAFF
}
